<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/list_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Waiting lists"
        android:textColor="@color/panel_muted"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/position"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:text="—"
        android:textColor="@color/panel_foreground"
        android:textSize="30sp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <TextView
            android:id="@+id/delta_up"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/success_foreground"
            android:textSize="11.5sp"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:visibility="gone" />
        <TextView
            android:id="@+id/delta_down"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/destructive_foreground"
            android:textSize="11.5sp"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:visibility="gone" />
        <TextView
            android:id="@+id/delta_muted"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/panel_muted"
            android:textSize="11.5sp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>
</LinearLayout>
